---
import type { CityNearby } from '@thailand-aq/types';
import type { i18n } from 'i18next';

interface Props {
  nearby: CityNearby[];
  t: i18n['t'];
}

const { nearby, t } = Astro.props;
---

{
  nearby.length > 0 && (
    <section aria-labelledby="nearby-heading">
      <h2 id="nearby-heading" class="text-lg font-semibold mb-3">{t('city.nearby')}</h2>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {nearby.map((city) => (
          <li>
            <a class="underline underline-offset-2" href={`/city/${city.slug}`}>
              {city.name}
            </a>
            {city.pm25 !== null && <span class="text-zinc-400"> {city.pm25} µg/m³</span>}
          </li>
        ))}
      </ul>
    </section>
  )
}
