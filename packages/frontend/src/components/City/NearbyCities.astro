---
import type { CityNearby } from '@thailand-aq/types';
import AqiChip from './AqiChip.astro';

interface Props {
  nearby: CityNearby[];
}

const { nearby } = Astro.props;
---

<ul class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-2">
  {
    nearby.map((city) => (
      <li>
        <a
          class="flex min-h-11 items-center justify-between rounded-md bg-zinc-800 px-3 py-2 text-[13px] text-zinc-200 hover:bg-zinc-700"
          href={`/city/${city.slug}`}
        >
          <span>{city.name}</span>
          {city.pm25 !== null && <AqiChip value={city.pm25} />}
        </a>
      </li>
    ))
  }
</ul>
