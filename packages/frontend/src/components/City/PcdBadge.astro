---
import type { i18n } from 'i18next';
import { contrastColor } from '@/utils/aqiColors';
import { pm25ToPcdBand } from '@/utils/pcdBands';

interface Props {
  /** PM2.5 in µg/m³; shown rounded */
  value: number;
  t: i18n['t'];
}

const { value, t } = Astro.props;
const band = pm25ToPcdBand(value);
const label = t(band.key as never);
const [r, g, b] = contrastColor(band.rgb);
---

<span
  class="inline-flex items-center gap-2 rounded py-1 pl-2 pr-2.5 text-[12px] font-medium"
  style={`background-color: rgb(${band.rgb.join(',')}); color: rgb(${r},${g},${b})`}
>
  <span class="text-[20px] font-semibold leading-none tabular-nums">{Math.round(value)}</span>
  <span class="max-w-22 text-[11px] leading-tight">{label}</span>
</span>
