---
import type { CityTrendDay } from '@thailand-aq/types';
import type { i18n } from 'i18next';
import { formatDay } from '@/lib/cityPage';

interface Props {
  trend: CityTrendDay[];
  t: i18n['t'];
}

const { trend, t } = Astro.props;
---

<div class="overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-zinc-400">
        <th class="py-1 font-medium">{t('city.colDate')}</th>
        <th class="py-1 font-medium">{t('city.colPm25')}</th>
      </tr>
    </thead>
    <tbody>
      {
        trend.map((day) => (
          <tr class="border-t border-zinc-800">
            <td class="py-1">
              <time datetime={day.date}>{formatDay(day.date)}</time>
            </td>
            <td class="py-1 font-mono">{day.pm25 ?? t('city.noReading')}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
