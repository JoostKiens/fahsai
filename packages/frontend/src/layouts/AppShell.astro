---
// The page's layout: header on top, sidebar and map side by side, scrubber below. Each region is
// its own island; they share the Zustand stores and one QueryClient (see src/islands). Each island
// sits in its own module: a client:only island next to a server-rendered one must not be imported
// by it, or the server build loads code that reads window.
import { HeaderIsland } from '@/islands/HeaderIsland';
import { SidebarIsland } from '@/islands/SidebarIsland';
import { MapIsland } from '@/islands/MapIsland';
import { ScrubberIsland } from '@/islands/ScrubberIsland';
---

<div class="flex flex-col h-full">
  <HeaderIsland client:only="react" />
  <div class="flex flex-1 overflow-hidden">
    <SidebarIsland client:only="react" />
    <MapIsland client:only="react">
      <slot name="fallback" slot="fallback" />
    </MapIsland>
  </div>
  <ScrubberIsland client:only="react" />
</div>
