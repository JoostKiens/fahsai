---
import Content from '@/layouts/Content.astro';
import TrendTable from '@/components/City/TrendTable.astro';
import StationsTable from '@/components/City/StationsTable.astro';
import NearbyCities from '@/components/City/NearbyCities.astro';
import Breadcrumb from '@/components/City/Breadcrumb.astro';
import KeyTiles from '@/components/City/KeyTiles.astro';
import ContentFooter from '@/components/ContentFooter.astro';
import { HeaderIsland } from '@/islands/HeaderIsland';
import { CityChartIsland } from '@/islands/CityChartIsland';
import { CityHeadlineIsland } from '@/islands/CityHeadlineIsland';
import { createI18n } from '@/i18n-instance';
import { cityCopyGroup } from '@/lib/cityCopy';
import {
  baselinePeriod,
  cityBreadcrumbs,
  cityJsonLd,
  cityMapLink,
  cityMeta,
  fetchBaselineDiff,
  fetchCityPage,
  keyTiles,
  listedStations,
  summaryHtml,
  timeHtml,
  trendDays,
} from '@/lib/cityPage';
import { fetchCityList } from '@/lib/sitemap';
import { pm25ToCategory } from '@/utils/aqiColors';

export const prerender = false;

const lang = 'en';
const { slug = '' } = Astro.params;
const result = await fetchCityPage(slug);
const { t } = createI18n(lang);

// 404 for a city that is not in the list, 503 when the API could not be reached. no-store keeps
// the ISR layer from holding either for the hour.
if (result.status !== 'ok') {
  Astro.response.status = result.status === 'not-found' ? 404 : 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}
const page = result.status === 'ok' ? result.page : null;
// both are optional extras (the baseline sentence, search finding a city page), fetched together
const [baselineDiff, cityList] = page
  ? await Promise.all([fetchBaselineDiff(page), fetchCityList({ timeoutMs: 1500 })])
  : [null, null];
// A page without the list would keep search from finding the city pages for as long as ISR holds
// it, so it is not held.
if (page && !cityList) Astro.response.headers.set('Cache-Control', 'no-store');
const cities = (cityList ?? []).map(({ slug, name, country }) => ({ slug, name, country }));
// TODO: say where the detected fires are ("mostly to the SE") once the API sends their direction
const meta = page
  ? { ...cityMeta(page, t), noindex: false }
  : {
      title: `${t('city.fallbackTitle')} | Fahsai`,
      description: t('city.unavailable'),
      canonical: Astro.url.href,
      noindex: true,
    };
const hasReading = page !== null && page.pm25 !== null;
const copyGroup = page ? cityCopyGroup(page.slug) : null;
const cardClass = 'rounded-lg border border-zinc-700/60 bg-zinc-900 p-4';
const headingClass = 'text-[13px] font-semibold text-zinc-100 mb-3';
---

<Content lang={lang} {...meta} jsonLd={page ? cityJsonLd(page, meta.title) : []}>
  <HeaderIsland client:load lang={lang} context="page" stationsDate={page?.date} cities={cities} />

  <main class="mx-auto w-full max-w-[1120px] px-4 py-6 flex flex-col gap-4">
    {page && <Breadcrumb crumbs={cityBreadcrumbs(page)} label={t('city.breadcrumb')} />}
    <h1 class="text-2xl font-semibold">{page ? t('city.h1', { name: page.name }) : t('city.fallbackTitle')}</h1>
    {
      page && (
        <p
          class="text-[13px] text-zinc-400"
          set:html={t('city.metaLine' as never, { date: timeHtml(page.date), count: page.stationCount })}
        />
      )
    }

    {!page && <p>{t('city.unavailable')}</p>}
    {page && !hasReading && <p>{t('city.noData', { name: page.name, date: page.date })}</p>}

    {
      page && page.pm25 !== null && (
        <>
          <div class="grid gap-4 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
            <section class={`${cardClass} flex flex-col gap-3`} aria-label={t('city.valueLabel')}>
              <p class="text-[12px] text-zinc-400">{t('city.valueLabel')}</p>
              <p class="flex items-baseline gap-2">
                <span class="font-mono text-[64px] leading-none font-medium">{page.pm25}</span>
                <span class="font-mono text-sm text-zinc-400">µg/m³</span>
              </p>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                <CityHeadlineIsland
                  lang={lang}
                  value={page.pm25}
                  category={t(pm25ToCategory(page.pm25).key as never)}
                />
                {page.whoMultiple !== null && (
                  <span class="text-[12px] text-zinc-400 font-mono">
                    {t('city.whoMultiple', { multiple: page.whoMultiple })}
                  </span>
                )}
              </div>
            </section>

            <section class={`${cardClass} flex flex-col gap-3`} aria-labelledby="driving-heading">
              <h2 id="driving-heading" class="text-[13px] font-semibold text-zinc-100">
                {t('city.driving')}
              </h2>
              <p class="text-sm text-zinc-300" set:html={summaryHtml(page, t, baselineDiff).join(' ')} />
              <p>
                <a
                  class="inline-block text-[13px] font-semibold text-teal-300 bg-teal-950 border border-teal-800 hover:bg-teal-900 rounded px-4 py-1.5 transition-colors ease-out"
                  href={cityMapLink(page)}
                >
                  {t('city.openInMap', { name: page.name })}
                </a>
              </p>
            </section>
          </div>

          <KeyTiles tiles={keyTiles(page, baselineDiff)} period={baselinePeriod(page.date, t)} t={t} />

          <div class="grid items-start gap-4 lg:grid-cols-2">
            <section class={cardClass} aria-labelledby="trend-heading">
              <h2 id="trend-heading" class={headingClass}>
                {t('city.trend')} <span class="font-mono font-normal text-zinc-400">µg/m³</span>
              </h2>
              <CityChartIsland client:visible lang={lang} days={trendDays(page)} barHeight={140} />
              <details class="mt-4">
                <summary class="cursor-pointer text-[13px] text-zinc-300">{t('city.showTable')}</summary>
                <div class="mt-2">
                  <TrendTable trend={page.trend} t={t} />
                </div>
              </details>
            </section>

            <section class={cardClass} aria-labelledby="stations-heading">
              <h2 id="stations-heading" class={headingClass}>
                {t('city.stationsWithin')}
              </h2>
              <StationsTable stations={listedStations(page)} t={t} />
            </section>
          </div>

          {page.nearby.length > 0 && (
            <section class={cardClass} aria-labelledby="nearby-heading">
              <h2 id="nearby-heading" class={headingClass}>
                {t('city.nearby')}
              </h2>
              <NearbyCities nearby={page.nearby} />
            </section>
          )}
        </>
      )
    }

    {
      page && (
        <div class={`grid items-start gap-4 ${copyGroup ? 'md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]' : ''}`}>
          {copyGroup && (
            <section class="flex flex-col gap-3 pr-4" aria-labelledby="why-heading">
              <h2 id="why-heading" class="text-lg font-semibold text-zinc-100">
                {t(`city.why.${copyGroup}.title` as never, { name: page.name })}
              </h2>
              <p class="text-sm text-zinc-300">{t(`city.why.${copyGroup}.p1` as never)}</p>
              <p class="text-sm text-zinc-300">{t(`city.why.${copyGroup}.p2` as never)}</p>
            </section>
          )}
          <section class={`${cardClass} flex flex-col gap-2 text-[12px] text-zinc-400`} aria-labelledby="data-heading">
            <h3 id="data-heading" class="text-[13px] font-semibold text-zinc-100">
              {t('city.dataHeading')}
            </h3>
            <p>{t('city.dataStations')}</p>
            <p>{t('city.dataFires')}</p>
            <p>{t('city.dataModel')}</p>
            <p set:html={t('city.dataDate', { date: timeHtml(page.date) })} />
          </section>
        </div>
      )
    }
  </main>

  <ContentFooter t={t} />
</Content>
