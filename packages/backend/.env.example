NODE_ENV=development
PORT=3001
LOG_LEVEL=                    # pino log level (debug/info/warn/error) — defaults to info

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=       # REST API URL — used by the cache client
UPSTASH_REDIS_REST_TOKEN=     # REST API token

# NASA FIRMS
FIRMS_MAP_KEY=

# OpenAQ
OPENAQ_API_KEY=

# Google Gemini (AI explanations — free tier: 1,500 req/day)
GEMINI_API_KEY=

# Copernicus CDS (ERA5 reanalysis — backfill only; key from https://cds.climate.copernicus.eu/profile)
CDS_API_KEY=

# Rollbar (error tracking — production only; server-side access token)
ROLLBAR_TOKEN=
